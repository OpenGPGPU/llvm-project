//
// This file is used as the registry of passes that are part of the OpenGPU
// backend.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef MODULE_PASS
#define MODULE_PASS(NAME, CREATE_PASS)
#endif
MODULE_PASS("opengpu-asm-printer-begin", OpenGPUAsmPrinterBeginPass())
MODULE_PASS("opengpu-asm-printer-end", OpenGPUAsmPrinterEndPass())
#undef MODULE_PASS

#ifndef MACHINE_FUNCTION_PASS
#define MACHINE_FUNCTION_PASS(NAME, CREATE_PASS)
#endif
MACHINE_FUNCTION_PASS("opengpu-asm-printer", OpenGPUAsmPrinterPass())
MACHINE_FUNCTION_PASS("opengpu-delay-slot-fillter", OpenGPUDelaySlotFillerPass())
MACHINE_FUNCTION_PASS("opengpu-isel", OpenGPUISelDAGToDAGPass(*this))
MACHINE_FUNCTION_PASS("opengpu-mem-alu-combiner", OpenGPUMemAluCombinerPass())
#undef MACHINE_FUNCTION_PASS
